# A password is not used. YouVersion rejects password sign-in from this app.
# Copy the yva_session cookie from https://www.bible.com after you sign in there.
# refresh-auth and sync use it to get a new access token.
# YOUVERSION_SESSION_COOKIE=

# Optional one-time token from /api/authenticate. This does not refresh.
# YOUVERSION_ACCESS_TOKEN=

# Seconds to wait between requests. The sync command will not go below 0.5.
YOUVERSION_DELAY_SECONDS=1.5
